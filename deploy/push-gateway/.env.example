# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PUSH_GATEWAY_MASTER_KEY=replace-with-at-least-32-random-characters
PUSH_GATEWAY_FIREBASE_PROJECT_ID=your-firebase-project-id
# Used only by the default standalone Nginx deployment.
PUSH_GATEWAY_DOMAIN=push.example.com
# Directory containing fullchain.pem and privkey.pem; renewal is managed externally.
PUSH_GATEWAY_TLS_DIR=./secrets/tls
