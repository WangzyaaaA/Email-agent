# Use: python -c "import secrets; print(secrets.token_urlsafe(48))"
EMAIL_AGENT_MASTER_KEY=replace-with-at-least-32-random-characters
EMAIL_AGENT_DATABASE_URL=sqlite:////data/mail_sentinel.db
EMAIL_AGENT_HOST=0.0.0.0
EMAIL_AGENT_PORT=8080
EMAIL_AGENT_TIMEZONE=Asia/Shanghai
EMAIL_AGENT_SECURE_COOKIES=false
EMAIL_AGENT_LOG_LEVEL=INFO
EMAIL_AGENT_ALLOW_LOOPBACK_GATEWAY_FOR_TESTS=false
